APP_NAME="VOKAMIN Côte d'Ivoire"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Africa/Abidjan
APP_URL=https://www.vokamin.ci
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

LOG_CHANNEL=daily
LOG_LEVEL=error

# Base de données (MySQL chez l'hébergeur)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=vokamin
DB_USERNAME=vokamin
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=240
SESSION_SECURE_COOKIE=true
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# Emails (SMTP de l'hébergeur ou messagerie professionnelle)
MAIL_MAILER=smtp
MAIL_HOST=mail.vokamin.ci
MAIL_PORT=465
MAIL_USERNAME=contact@vokamin.ci
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="contact@vokamin.ci"
MAIL_FROM_NAME="VOKAMIN Côte d'Ivoire"

# Adresse qui reçoit les notifications (devis, contact, candidatures)
VOKAMIN_NOTIFY_EMAIL=info@vokamin.com

# Compte administrateur créé par « php artisan db:seed »
ADMIN_NAME="Administrateur VOKAMIN"
ADMIN_EMAIL=admin@vokamin.ci
ADMIN_PASSWORD=ChangezMoi-2026!

# Mesure d'audience (facultatif) : identifiant Google Analytics 4, ex. G-XXXXXXX
VOKAMIN_GA_ID=

VITE_APP_NAME="${APP_NAME}"
