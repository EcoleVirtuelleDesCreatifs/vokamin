server {
    listen 80;
    server_name vokamin.ci www.vokamin.ci;
    return 301 https://www.vokamin.ci$request_uri;
}

server {
    listen 443 ssl http2;
    server_name www.vokamin.ci;
    root /var/www/vokamin/public;
    index index.php;

    ssl_certificate     /etc/letsencrypt/live/www.vokamin.ci/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/www.vokamin.ci/privkey.pem;

    client_max_body_size 60M;   # pièces jointes des devis
    add_header X-Frame-Options "SAMEORIGIN";
    add_header X-Content-Type-Options "nosniff";

    location / { try_files $uri $uri/ /index.php?$query_string; }
    location ~ \.php$ {
        fastcgi_pass unix:/run/php/php8.3-fpm.sock;
        fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
        include fastcgi_params;
    }
    location ~* \.(jpg|jpeg|png|webp|svg|css|js|woff2)$ { try_files $uri /index.php?$query_string; expires 1y; access_log off; }
    location ~ /\.(?!well-known).* { deny all; }
}
