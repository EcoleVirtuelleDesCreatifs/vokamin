# Utilisé uniquement si la racine du domaine ne peut pas pointer sur public/
<IfModule mod_rewrite.c>
    RewriteEngine On
    # « storage/ » n'est pas bloqué ici : /storage/... est réécrit vers public/storage
    # (images des actualités et réalisations), jamais vers le dossier storage/ privé.
    RewriteRule ^(\.env|\.git|composer\.(json|lock)|artisan|vendor/|database/|app/|config/|routes/|resources/|bootstrap/) - [F,L]
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
